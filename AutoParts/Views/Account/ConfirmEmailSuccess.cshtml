@{
    ViewData["Title"] = "Пошта підтверджена";
}

<div class="container mt-5 pt-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="card border-0 shadow-lg p-5 rounded-4" style="max-width: 600px; width: 100%;">
        <div class="mb-4">
            <i class="fa-solid fa-circle-check text-success" style="font-size: 5rem;"></i>
        </div>

        <h2 class="fw-bold mb-3 text-dark">Пошту успішно підтверджено!</h2>

        <p class="text-muted mb-4 fs-6 px-3">
            Дякуємо! Ваша електронна адреса підтверджена. Тепер ви можете увійти до свого особистого кабінету та почати замовляти запчастини в <span class="fw-bold text-dark">AUTO<span class="text-danger">PARTS</span></span>.
        </p>

        <div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-danger px-5 py-2 fw-bold rounded-pill shadow-sm">
                УВІЙТИ НА САЙТ
            </a>
        </div>
    </div>
</div>