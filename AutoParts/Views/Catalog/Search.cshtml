@model AutoParts.ViewModels.CatalogSearchViewModel

@{
    ViewData["Title"] = "Каталог запчастин";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet">
}

<div class="container py-4">

    @if (Model.ActiveVehicle == null)
    {
        <div class="mb-4 shadow-sm bg-white rounded border p-3">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-car text-danger me-2"></i>Оберіть автомобіль для точного підбору:</h5>
            <partial name="_VehicleFilter" model="Model.AvailableYears" />
        </div>
    }
    else
    {
        <div class="active-vehicle-banner shadow-sm flex-column align-items-stretch mb-4 p-3 bg-white rounded border">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-car-side fs-2 text-danger me-3"></i>
                    <div>
                        <span class="text-muted small d-block mb-1">Обраний автомобіль:</span>
                        <h1 class="active-vehicle-title m-0 fs-4 fw-bold text-dark">
                            @($"{Model.ActiveVehicle.Make?.Name} {Model.ActiveVehicle.Model?.Name} {Model.ActiveVehicle.Year}")
                        </h1>
                    </div>
                </div>
                <button class="btn btn-outline-secondary px-4 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#changeVehicleCollapse">Змінити авто</button>
            </div>

            <div class="collapse mt-3" id="changeVehicleCollapse">
                <div class="pt-3 border-top">
                    <partial name="_VehicleFilter" model="Model.AvailableYears" />
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="catalog-sidebar shadow-sm p-3 bg-white rounded border">
                <form id="filterForm" method="get" asp-controller="Catalog" asp-action="Search">
                    <input type="hidden" name="vehicleId" value="@Model.SelectedVehicleId" />

                    <div class="filter-section pb-2 border-bottom mb-3">
                        <h5 class="filter-title fw-bold mb-2">Ціна</h5>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                            <input type="number" class="form-control text-center price-input-visible" id="minPriceInput" name="minPrice" value="@Model.SelectedMinPrice">
                            <span class="mx-2 text-muted fw-bold">-</span>
                            <input type="number" class="form-control text-center price-input-visible" id="maxPriceInput" name="maxPrice" value="@Model.SelectedMaxPrice">
                        </div>
                        <div class="px-1 mb-3">
                            <div id="price-slider" data-catalog-min="@Model.CatalogMinPrice.ToString("0")" data-catalog-max="@Model.CatalogMaxPrice.ToString("0")"></div>
                        </div>
                    </div>

                    <div class="filter-section pb-2 border-bottom mb-3">
                        <h5 class="filter-title fw-bold mb-2">Категорії</h5>
                        @foreach (var cat in Model.Categories)
                        {
                            var isChecked = Model.SelectedCategories.Contains(cat.Id) ? "checked" : "";
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="categories" value="@cat.Id" id="cat_@cat.Id" @isChecked onchange="document.getElementById('filterForm').submit();">
                                <label class="form-check-label small" for="cat_@cat.Id">@cat.Name</label>
                            </div>
                        }
                    </div>

                    <div class="filter-section mb-0">
                        <h5 class="filter-title fw-bold mb-2">Виробники</h5>
                        @foreach (var brand in Model.Brands)
                        {
                            var isChecked = Model.SelectedBrands.Contains(brand.Id) ? "checked" : "";
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="brands" value="@brand.Id" id="brand_@brand.Id" @isChecked onchange="document.getElementById('filterForm').submit();">
                                <label class="form-check-label small" for="brand_@brand.Id">@brand.Name</label>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
                <h5 class="m-0 text-muted mb-3 mb-md-0">Знайдено результатів: <span class="text-dark fw-bold">@Model.Parts.Count</span></h5>

                <div class="d-flex align-items-center">
                    <label class="me-3 text-muted text-nowrap mb-0 fw-bold small">Сортувати:</label>
                    <select class="form-select form-select-sm py-2 custom-sort-select" name="sortOrder" form="filterForm" onchange="document.getElementById('filterForm').submit();" style="width: 220px; cursor: pointer; height: 38px;">
                        <option value="relevance" selected="@(Model.SelectedSortOrder == "relevance")">За релевантністю</option>
                        <option value="price_asc" selected="@(Model.SelectedSortOrder == "price_asc")">За зростанням ціни</option>
                        <option value="price_desc" selected="@(Model.SelectedSortOrder == "price_desc")">За спаданням ціни</option>
                    </select>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 catalog-grid">
                @if (!Model.Parts.Any())
                {
                    <div class="col-12 text-center py-5"><h4 class="text-muted">Нічого не знайдено</h4></div>
                }
                else
                {
                    @foreach (var part in Model.Parts)
                    {
                        <partial name="_ProductCard" model="part" />
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}