@model List<AutoParts.Models.AutoPart>

@{
    ViewData["Title"] = "Інвентаризація";
}

<div class="container-fluid py-4 px-5">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Manager" asp-action="Index" class="btn btn-light border btn-sm me-3" style="border-radius: 8px;">
            <i class="fa-solid fa-arrow-left"></i> Панель
        </a>
        <h2 class="fw-bold m-0">Інвентаризація та залишки</h2>
    </div>

    <form id="inventory-form" asp-controller="Manager" asp-action="UpdateAllStock" method="post">
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between align-items-end mb-3">
            <div class="card border-0 shadow-sm p-3 w-75">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Пошук запчастини</label>
                        <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="Введіть назву..." value="@Context.Request.Query["searchTerm"]" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="lowStockOnly" id="lowStockCheck" value="true" @(Context.Request.Query["lowStockOnly"] == "true" ? "checked" : "")>
                            <label class="form-check-label small fw-bold text-muted" for="lowStockCheck">Лише дефіцит (≤ 5)</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" asp-controller="Manager" asp-action="Inventory" formmethod="get" class="btn btn-sm btn-outline-secondary w-100">Пошук</button>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-danger px-4 py-2 fw-bold shadow-sm">
                <i class="fa-solid fa-floppy-disk me-2"></i> Зберегти всі зміни
            </button>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="py-3 ps-4">Назва запчастини</th>
                            <th class="py-3">Категорія</th>
                            <th class="py-3 text-center" style="width: 120px;">Ціна (₴)</th>
                            <th class="py-3 text-center" style="width: 120px;">Кількість</th>
                            <th class="py-3 text-end pe-4" style="width: 100px;">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var part in Model)
                        {
                            bool isLowStock = part.StockQuantity <= 5;
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark d-block">@part.Name</span>
                                    <span class="text-muted small">SKU: @(string.IsNullOrEmpty(part.SKU) ? "—" : part.SKU)</span>
                                </td>
                                <td><span class="badge bg-light border text-dark">@part.Category?.Name</span></td>

                                <td class="text-center">
                                    <input type="number" step="0.01" name="prices[@part.Id]" class="form-control form-control-sm text-center fw-bold text-dark" value="@part.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" style="width: 90px; display: inline-block;" />
                                </td>

                                <td class="text-center">
                                    <input type="number" name="stocks[@part.Id]" class="form-control form-control-sm text-center fw-bold @(isLowStock ? "text-danger" : "text-dark")" value="@part.StockQuantity" style="width: 70px; display: inline-block;" />
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="EditPart" asp-route-id="@part.Id" class="btn btn-sm btn-outline-secondary" title="Редагувати детально">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/manager.js" asp-append-version="true"></script>
}