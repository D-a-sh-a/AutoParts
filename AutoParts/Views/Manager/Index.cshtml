@model AutoParts.ViewModels.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Панель управління";
}

<div class="container-fluid py-4 px-5">
    <h2 class="fw-bold mb-4">Панель управління замовленнями</h2>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 border-bottom pb-3">

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Manager" asp-action="CreateOrder" class="btn btn-danger d-flex align-items-center gap-2 px-3 py-2 fw-medium shadow-sm">
                <i class="fa-solid fa-plus"></i>
                <span>Створити замовлення</span>
            </a>
            <a asp-controller="Manager" asp-action="Inventory" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-medium shadow-sm bg-white text-dark">
                <i class="fa-solid fa-boxes-stacked text-muted"></i>
                <span>Інвентаризація</span>
            </a>
            <a asp-controller="Manager" asp-action="CreatePart" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-medium shadow-sm bg-white text-dark">
                <i class="fa-solid fa-gear text-muted"></i>
                <span>Додати запчастину</span>
            </a>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="m-0">
            @Html.AntiForgeryToken()
            <a href="javascript:void(0)"
               onclick="document.getElementById('logoutForm').submit();"
               class="btn btn-light border d-flex align-items-center gap-2 px-3 py-2 fw-bold text-danger shadow-sm">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                <span>Вийти з акаунта</span>
            </a>
        </form>

    </div>

    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="text-muted fw-bold">Фільтр:</span>
        <select name="statusFilter" class="form-select" style="width: 200px;" onchange="this.form.submit()">
            <option value="">Усі замовлення</option>
            <option value="Pending" selected='@(Context.Request.Query["statusFilter"] == "Pending")'>В очікуванні</option>
            <option value="Processing" selected='@(Context.Request.Query["statusFilter"] == "Processing")'>В обробці</option>
            <option value="Shipped" selected='@(Context.Request.Query["statusFilter"] == "Shipped")'>Відправлено</option>
            <option value="Cancelled" selected='@(Context.Request.Query["statusFilter"] == "Cancelled")'>Скасовано</option>
        </select>
    </div>

    <div class="card border-0 shadow-sm p-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>№</th>
                    <th>Клієнт</th>
                    <th>Дата</th>
                    <th>Сума</th>
                    <th>Статус</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td class="fw-bold">#@order.Id</td>
                        <td>@order.CustomerName</td>
                        <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                        <td>@order.TotalSum.ToString("0") грн</td>
                        <td>
                            <span class="badge bg-secondary">@AutoParts.Controllers.ManagerController.GetStatusDisplayName(order.Status)</span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Manager" asp-action="EditOrder" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">Редагувати</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="~/js/manager.js" asp-append-version="true"></script>
}