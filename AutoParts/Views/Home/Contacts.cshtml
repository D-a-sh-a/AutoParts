@{
    ViewData["Title"] = "Контакти";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" />
}

<div class="container my-5">
    <h1 class="mb-4">Контакти</h1>

    <div class="alert alert-success alert-dismissible fade show d-none" role="alert">
        Дякуємо! Ваше повідомлення успішно відправлено.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4 mb-md-0">
            <h3 class="mb-3">Наші координати</h3>
            <ul class="list-unstyled text-muted">
                <li class="mb-2"><i class="bi bi-geo-alt-fill text-danger me-2"></i> <strong>Адреса:</strong> вул. Соборна, 1, м. Рівне, Україна</li>
                <li class="mb-2"><i class="bi bi-telephone-fill text-danger me-2"></i> <strong>Телефон:</strong> +38 (099) 123-45-67</li>
                <li class="mb-2"><i class="bi bi-envelope-fill text-danger me-2"></i> <strong>Email:</strong> info@autoparts.com</li>
            </ul>

            <h4 class="mt-4 mb-3">Графік роботи</h4>
            <ul class="list-unstyled text-muted">
                <li class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span>Понеділок - П'ятниця:</span> <span>09:00 - 19:00</span>
                </li>
                <li class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span>Субота:</span> <span>10:00 - 16:00</span>
                </li>
                <li class="d-flex justify-content-between text-danger fw-bold">
                    <span>Неділя:</span> <span>Вихідний</span>
                </li>
            </ul>

            <div class="mt-4 rounded overflow-hidden shadow-sm">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d161559.782046896!2d26.113063864197855!3d50.61962326775685!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x472f13501a35b1b1%3A0x673c683b52d921b0!2sRivne%2C%20Rivne%20Oblast%2C%20Ukraine!5e0!3m2!1sen!2sus!4v1717200000000!5m2!1sen!2sus"
                        width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div> <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="mb-4">Напишіть нам</h3>

                <form action="#" method="post">
                    <div class="mb-3">
                        <label for="Name" class="form-label fw-bold">Ваше ім'я</label>
                        <input type="text" id="Name" name="Name" class="form-control focus-ring" placeholder="Іван Іванов" />
                    </div>

                    <div class="mb-3">
                        <label for="Email" class="form-label fw-bold">Ваш Email</label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="example@mail.com" />
                    </div>

                    <div class="mb-4">
                        <label for="Message" class="form-label fw-bold">Повідомлення</label>
                        <textarea id="Message" name="Message" class="form-control" rows="5" placeholder="Як ми можемо вам допомогти?"></textarea>
                    </div>

                    <button type="button" class="btn btn-search w-100 py-2">ВІДПРАВИТИ ПОВІДОМЛЕННЯ</button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>