@model AutoParts.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Головна";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-section text-center">
    <div class="container">
        <h1 class="hero-title mb-5">Підберіть <span class="text-danger">Ідеальні</span> Запчастини</h1>

        <partial name="_VehicleFilter" model="Model.AvailableYears" />
    </div>
</section>

<div class="container mt-5">

    <h3 class="fw-bold mb-4">Популярні категорії</h3>

    <div class="position-relative mb-5">
        <button class="category-nav-btn left-btn" id="catScrollLeft">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="category-scroll-container" id="categoryContainer">
            @foreach (var cat in Model.Categories)
            {
                <a href="/Catalog/Search?categories=@cat.Id" class="text-decoration-none text-dark">
                    <div class="category-card">
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" alt="@cat.Name">
                        }
                        else
                        {
                            <i class="fa-solid fa-gears fa-3x text-secondary mb-3 d-block"></i>
                        }
                        <h6 class="fw-bold m-0">@cat.Name</h6>
                    </div>
                </a>
            }
        </div>

        <button class="category-nav-btn right-btn" id="catScrollRight">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h3 class="fw-bold m-0 border-bottom-red pb-2">Рекомендовані товари</h3>
        <a href="#" class="text-decoration-none text-muted">Дивитися всі</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4 mb-5">
        @foreach (var part in Model.FeaturedParts)
        {
            <partial name="_ProductCard" model="part" />
        }
    </div>
</div>
<section class="brands-section">
    <div class="container text-center">
        <h2 class="text-white mb-5 fw-bold">Обирайте за брендами</h2>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 justify-content-center">
            @foreach (var brand in Model.Brands)
            {
                <div class="col">
                    <a href="/Catalog/Search?brands=@brand.Id" class="brand-card">
                        <img src="@brand.ImageUrl" alt="@brand.Name" title="@brand.Name">
                    </a>
                </div>
            }
        </div>
    </div>
</div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}