@model AutoParts.Models.AutoPart

@{
    bool isOutOfStock = Model.StockQuantity <= 0;
    string outOfStockClass = isOutOfStock ? "out-of-stock" : "";
}

<div class="col">
    <div class="card product-card h-100 border-0 shadow-sm @outOfStockClass">
        <div class="product-img-wrapper p-3 text-center position-relative">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <button type="button" class="wishlist-btn favorite-btn" data-id="@Model.Id" style="z-index: 10; border: none; background: none; cursor: pointer;" title="Додати в улюблені">
                    <i class="fa-regular fa-heart"></i>
                </button>
            }

            @{
                bool hasImages = Model.ImageUrls != null && Model.ImageUrls.Any();
                var firstImg = hasImages ? Model.ImageUrls.First() : null;
                var secondImg = hasImages ? Model.ImageUrls.Skip(1).FirstOrDefault() : null;
            }
            @if (hasImages)
            {
                <img src="@firstImg" class="card-img-top primary-img @(secondImg != null ? "fade-on-hover" : "")" alt="@Model.Name" style="object-fit: contain; height: 160px; transition: opacity 0.3s;">
                @if (secondImg != null)
                {
                    <img src="@secondImg" class="card-img-top secondary-img" alt="@Model.Name" style="object-fit: contain; height: 160px; position: absolute; top: 1rem; left: 0; width: 100%; opacity: 0; transition: opacity 0.3s; pointer-events: none;">
                }
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center bg-light rounded" style="height: 160px;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-2">
                        <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z" stroke="#ef233c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="#212529" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="fw-bold text-dark" style="font-size:0.75rem;">AUTO<span class="text-danger">PARTS</span></span>
                </div>
            }
        </div>

        <div class="card-body d-flex flex-column text-start">
            <small class="text-muted mb-1" style="font-size: 0.85rem;">@Model.Category?.Name</small>
            <h6 class="card-title fw-normal mb-4 product-name" style="font-size: 0.95rem;">@Model.Name</h6>

            <div class="mt-auto d-flex justify-content-between align-items-end">
                @if (!isOutOfStock)
                {
                    <span class="fs-5 fw-bold text-dark">@Model.Price.ToString("0") <span class="text-muted fs-6 fw-normal">грн</span></span>

                    <button type="button" class="btn btn-light add-cart-btn add-to-cart-btn rounded-circle d-flex align-items-center justify-content-center" data-id="@Model.Id" title="В кошик" style="cursor: pointer;">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </button>
                }
                else
                {
                    <span class="fs-6 fw-bold text-danger pb-1">Товар відсутній</span>

                    <button type="button" class="btn btn-light rounded-circle d-flex align-items-center justify-content-center" style="opacity: 0.4; cursor: not-allowed; width: 40px; height: 40px;" title="Немає в наявності" disabled>
                        <i class="fa-solid fa-cart-shopping"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>