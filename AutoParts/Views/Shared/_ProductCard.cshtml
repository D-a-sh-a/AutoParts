<div class="col">
    <div class="card product-card h-100 border-0 shadow-sm">
        <div class="product-img-wrapper p-3 text-center position-relative">
            <button class="wishlist-btn" style="z-index: 10;">
                <i class="fa-regular fa-heart"></i>
            </button>

            <img src="/img/placeholder-part.jpg" class="card-img-top primary-img" alt="Назва товару" style="object-fit: contain; height: 160px; transition: opacity 0.3s;">
        </div>

        <div class="card-body d-flex flex-column text-start">
            <small class="text-muted mb-1" style="font-size: 0.85rem;">Категорія товару</small>

            <h6 class="card-title fw-normal mb-4 product-name" style="font-size: 0.95rem;">Назва автомобільної запчастини (наприклад, Гальмівні колодки)</h6>

            <div class="mt-auto d-flex justify-content-between align-items-end">
                <span class="fs-5 fw-bold text-dark">1200 <span class="text-muted fs-6 fw-normal">грн</span></span>

                <button class="btn btn-light add-cart-btn rounded-circle d-flex align-items-center justify-content-center" title="В кошик">
                    <i class="fa-solid fa-cart-shopping"></i>
                </button>
            </div>
        </div>
    </div>
</div>