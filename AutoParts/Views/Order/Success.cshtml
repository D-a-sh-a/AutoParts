@{
    ViewData["Title"] = "Замовлення оформлено!";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center py-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-5" style="border-radius: 16px;">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-check display-4"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-2">Дякуємо за замовлення!</h2>
                <p class="text-muted mb-4">Ваша заявка успішно прийнята та вже обробляється менеджером.</p>

                <div class="bg-light p-3 rounded mb-4 shadow-inner" style="border-radius: 8px;">
                    <span class="text-muted d-block small mb-1">Номер вашого замовлення:</span>
                    <span class="fw-bold text-dark fs-4">#@ViewBag.OrderId</span>
                </div>

                <p class="small text-muted mb-4">
                    На вказану вами електронну адресу надіслано лист із деталями замовлення.
                    Ми зв'яжемося з вами найближчим часом для підтвердження доставки.
                </p>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="/" class="btn btn-danger fw-bold px-4 py-2" style="border-radius: 8px; background-color: #ef233c;">
                        На головну
                    </a>
                    <a href="/Catalog/Search" class="btn btn-outline-secondary fw-bold px-4 py-2" style="border-radius: 8px;">
                        Продовжити покупки
                    </a>
                </div>
            </div>
        </div>
    </div>
</div> 