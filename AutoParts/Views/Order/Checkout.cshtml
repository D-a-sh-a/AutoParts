@model AutoParts.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Оформлення замовлення";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <i class="fa-solid fa-basket-shopping text-danger fs-3 me-3"></i>
        <h2 class="fw-bold m-0">Оформлення замовлення</h2>
    </div>

    <form asp-controller="Order" asp-action="Checkout" method="post">
        <div class="row">
            <div class="col-lg-7 mb-4">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-4 text-dark"><i class="fa-regular fa-id-card text-danger me-2"></i> Контактні дані</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="FirstName" class="form-control bg-light border-0 py-2" style="border-radius: 8px;" placeholder="Ім'я" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="LastName" class="form-control bg-light border-0 py-2" style="border-radius: 8px;" placeholder="Прізвище" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="Email" type="email" class="form-control bg-light border-0 py-2" style="border-radius: 8px;" placeholder="example@mail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="Phone" class="form-control bg-light border-0 py-2" style="border-radius: 8px;" placeholder="+380" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 text-dark pt-2 border-top"><i class="fa-solid fa-truck text-danger me-2"></i> Доставка</h5>
                    <div class="mb-4">
                        <label asp-for="Address" class="form-label small fw-bold text-muted"></label>
                        <input asp-for="Address" class="form-control bg-light border-0 py-2" style="border-radius: 8px;" placeholder="Місто, номер відділення Нової Пошти або адреса" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Comment" class="form-label small fw-bold text-muted">Коментар до замовлення (необов'язково)</label>
                        <textarea asp-for="Comment" class="form-control bg-light border-0" rows="3" style="border-radius: 8px;" placeholder="Вкажіть ваші побажання щодо замовлення..."></textarea>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 20px; z-index: 10;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-dark">Ваше замовлення</h5>

                    <div class="overflow-auto mb-3" style="max-height: 280px;">
                        <ul class="list-unstyled m-0">
                            @foreach (var item in Model.CartItems)
                            {
                                <li class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom pe-2">
                                    <div style="max-width: 75%;">
                                        <h6 class="m-0 fw-normal text-dark" style="font-size: 0.9rem; line-height: 1.3;">@item.AutoPart!.Name</h6>
                                        <small class="text-muted">Код: @item.AutoPart.SKU</small>
                                        <div class="small mt-1">
                                            <span class="text-muted">@item.Quantity шт. x </span>
                                            <span class="fw-semibold">@item.AutoPart.Price.ToString("0") грн</span>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-dark" style="font-size: 0.95rem;">
                                        @((item.Quantity * item.AutoPart.Price).ToString("0")) грн
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between align-items-center my-3 pt-2">
                        <span class="fw-bold text-muted small">Всього товарів:</span>
                        <span class="fw-bold text-dark">@Model.CartItems.Sum(i => i.Quantity) шт.</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 border-top pt-3">
                        <span class="fw-bold fs-5 text-dark">До сплати:</span>
                        <span class="fw-bold fs-4 text-danger">@Model.TotalAmount.ToString("0") <span class="fs-6 fw-normal text-muted">грн</span></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm border-0 transition-all" style="border-radius: 8px; background-color: #ef233c;">
                        <i class="fa-solid fa-check me-2"></i> ПІДТВЕРДИТИ ЗАМОВЛЕННЯ
                    </button>

                    <div class="text-center mt-3">
                        <a href="/Cart/Index" class="small text-muted text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Повернутись до кошика</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}